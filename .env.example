# Copy to .env and fill in. Never commit .env.
#
# POESESSID is a full-account session cookie: treat it like your password.
# Get it while logged in at pathofexile.com:
#   browser devtools -> Application/Storage -> Cookies -> https://www.pathofexile.com
# No quotes. Logging out of pathofexile.com invalidates it.
POESESSID=

# Account name, optionally with the #1234 discriminator. If omitted, the app reads
# the discriminator from your profile page.
ACCOUNT_NAME=

# League to price. Must match the league shown on the trade site.
LEAGUE=Standard
REALM=pc

# Local web UI. The server always binds to 127.0.0.1, never the network.
PORT=5173

# Sent with requests to GGG and poe.ninja. Please keep it descriptive.
# USER_AGENT=poe-pricer/0.1 (personal use)

# Background behavior. See README.md -> Configuration.
# AUTO_SCAN_MINUTES=10
# TRASH_CHAOS=3
# EXPLORE_PER_SCAN=0
# EXPLORE_RATE=0.1
# PROBE_SECONDS=60
# PROBE_IDLE_MINUTES=10
